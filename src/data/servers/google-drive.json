        "title": "Set Config in Assistant",
        "language": "json",
        "code": "{\n  \"mcpServers\": {\n    \"gdrive\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-gdrive\"],\n      \"env\": {\n        \"GDRIVE_CREDENTIALS_PATH\": \"/Users/name/.gdrive/credentials.json\"\n      }\n    }\n  }\n}"
