  "envVars": [
    {
      "name": "GDRIVE_CREDENTIALS_PATH",
      "required": true,
      "description": "Absolute path to Google Cloud OAuth credentials JSON file.",
      "placeholder": "/path/to/credentials.json"
    }
  ],
  "tools": [
    {
      "name": "search",
      "description": "Search for files in Google Drive by filename or content keywords."
    },
    {
