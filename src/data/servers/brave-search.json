      "Node.js 18+"
    ],
    "installSteps": [
      {
        "title": "Get Free Brave API Key",
        "description": "Register at https://brave.com/search/api/ to get your API key."
      },
      {
        "title": "Add to MCP Config",
        "language": "json",
        "code": "{\n  \"mcpServers\": {\n    \"brave-search\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-brave-search\"],\n      \"env\": {\n        \"BRAVE_API_KEY\": \"YOUR_API_KEY_HERE\"\n      }\n    }\n  }\n}"
      }
    ],
    "examples": [
